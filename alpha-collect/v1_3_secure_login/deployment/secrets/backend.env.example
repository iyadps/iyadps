# Copy to secrets/backend.env (gitignored). Restrict permissions to operator.
ALPHA_COLLECT_PUBLIC_URL=https://collect-staging.example.org
ALPHA_KOBO_BASE_URL=https://kf.kobotoolbox.org
ALPHA_KOBO_OWNER=alpha_pilot_account
ALPHA_KOBO_PROJECTS={"PILOT":{"uid":"a0123456789koboform","form_id":"pilot_form","title":"Pilot Questionnaire"}}
# NEVER commit a real token. Use a dedicated least-privilege pilot Kobo account.
ALPHA_KOBO_API_TOKEN=REPLACE_WITH_SECRET_FROM_KOBO_ACCOUNT
